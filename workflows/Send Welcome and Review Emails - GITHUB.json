    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  const checkIn = new Date(data[\"Check-in Date\"] + \"T00:00:00\");\n  const checkOut = new Date(data[\"Check-out Date\"] + \"T00:00:00\");\n\n  // Difference in days\n  const daysUntilCheckIn = Math.ceil(\n    (checkIn - now) / (1000 * 60 * 60 * 24)\n  );\n\n  const daysSinceCheckOut = Math.floor(\n    (now - checkOut) / (1000 * 60 * 60 * 24)\n  );\n\n  // Determine what action this reservation needs\n  let action = \"No Action\";\n\n  if (\n    daysUntilCheckIn >= 0 &&\n    daysUntilCheckIn <= 2 &&\n    data[\"Welcome Email Sent\"] === \"No\"\n  ) {\n    action = \"Send Welcome Email\";\n  } \n  else if (\n    daysSinceCheckOut >= 1 &&\n    data[\"Review Email Sent\"] === \"No\"\n  ) {\n    action = \"Send Review Email\";\n  }\n\n  return {\n    json: {\n      ...data,\n      daysUntilCheckIn,\n      daysSinceCheckOut,\n      action\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
